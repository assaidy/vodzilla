# NOTE: Local dev defaults, intentionally committed. Not a production project.
PORT       = 8080
EMAIL_FROM = noreply@vodzilla.com

__DOCKER_VOLUMES_DIR = ~/.local/share/my_docker_data/vodzilla

POSTGRES_PORT        = 2345
POSTGRES_USER        = postgres
POSTGRES_PASSWORD    = postgres
POSTGRES_NAME        = vodzilla
POSTGRES_URL         = postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:${POSTGRES_PORT}/${POSTGRES_NAME}?sslmode=disable
POSTGRES_VOLUME_PATH = ${__DOCKER_VOLUMES_DIR}/postgres/

REDIS_PORT         = 9736
REDIS_ADDR         = localhost:${REDIS_PORT}
REDIS_VOLUME_PATH  = ${__DOCKER_VOLUMES_DIR}/redis/

PAPERCUT_HOST     = localhost
PAPERCUT_PORT     = 25
PAPERCUT_WEB_PORT = 3000
PAPERCUT_USERNAME = papercut
PAPERCUT_PASSWORD = papercut

RUSTFS_PORT          = 9000
RUSTFS_CONSOLE_PORT  = 9001
RUSTFS_URL           = http://localhost:${RUSTFS_PORT}
RUSTFS_ACCESS_KEY    = rustfs
RUSTFS_SECRET_KEY    = rustfs
RUSTFS_VOLUME_PATH   = ${__DOCKER_VOLUMES_DIR}/rustfs/
